{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Frontend (Flutter - Selected Device/Desktop)",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--dart-define=API_BASE_URL=https://backend-winter-waterfall-5807.fly.dev/api/v1"
            ]
        },
        {
            "name": "Frontend (Flutter - Selected Emulator)",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--dart-define=API_BASE_URL=https://backend-winter-waterfall-5807.fly.dev/api/v1"
            ]
        },
        {
            "name": "Frontend (Flutter - Prod Backend)",
            "type": "dart",
            "request": "launch",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--dart-define=API_BASE_URL=https://backend-winter-waterfall-5807.fly.dev/api/v1"
            ]
        }
    ],
    "compounds": [
        {
            "name": "SupaNotes Dev (Device/Desktop)",
            "configurations": [
                "Frontend (Flutter - Selected Device/Desktop)"
            ]
        },
        {
            "name": "SupaNotes Dev (Emulator)",
            "configurations": [
                "Frontend (Flutter - Selected Emulator)"
            ]
        }
    ]
