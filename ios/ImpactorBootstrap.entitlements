<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The Apple ID signer discovers capabilities from the entitlements embedded
	  in each Mach-O binary. The final signer replaces this ad-hoc signature.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.supanotes.shared</string>
	</array>
</dict>
</plist>
